# Copie para .env e ajuste. Nunca commite o .env.

POSTGRES_USER=avaliacao
POSTGRES_PASSWORD=avaliacao
POSTGRES_DB=gestao_projetos
POSTGRES_PORT=5432

# Nest/Prisma falam com o container via localhost (app fora do Docker).
DATABASE_URL=postgresql://avaliacao:avaliacao@127.0.0.1:5432/gestao_projetos?schema=public

JWT_SECRET=troque-isto-em-cada-ambiente
JWT_EXPIRES_IN=1d

# Exigida em toda rota, no header x-api-key. O frontend local usa o mesmo valor em VITE_API_KEY.
API_KEY=troque-isto-em-cada-ambiente

# Conta ADMIN criada pelo seed (npm run seed). Troque a senha.
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=admin1234

# Browser do frontend local. O Vite (5173) também faz proxy em /api, então o CORS
# só importa quando a base da API no cliente é http://localhost:3000 direto.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Brasil API. O ano entra no caminho: {HOLIDAYS_API_URL}/{year}
HOLIDAYS_API_URL=https://brasilapi.com.br/api/feriados/v1

# Pasta local das imagens de tarefa. Se omitir, a API usa ./uploads (gitignored).
# UPLOAD_DIR=uploads
